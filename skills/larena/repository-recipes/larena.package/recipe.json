{
  "$schema": "https://simai.io/schemas/federation/repository-recipe.schema.json",
  "schema_version": "2.0.0",
  "id": "larena.package",
  "version": "2.0.0",
  "kind": "structural_recipe",
  "owner": "larena",
  "title": "larena.package",
  "repository_family": "larena",
  "repository_kind": "package",
  "base_recipe": "generic.repository",
  "compatibility": {
    "allowed_bases": [
      "generic.repository"
    ],
    "allowed_overlays": [
      "larena.technology-overlay",
      "docs.technology-overlay",
      "tester.technology-overlay"
    ],
    "incompatible_recipes": [
      "graph.domain_atlas",
      "client.project",
      "bitrix.module",
      "bitrix.client_project",
      "sf4.project",
      "sf5.project",
      "orgportal.solution",
      "docara.project"
    ]
  },
  "capabilities": [
    {
      "id": "project_technology",
      "activation": "optional"
    }
  ],
  "requires_capabilities": [

  ],
  "required_inputs": [
    {
      "name": "repository_name",
      "required": true,
      "type": "string"
    },
    {
      "name": "package_name",
      "required": true,
      "type": "string"
    },
    {
      "name": "php_namespace",
      "required": true,
      "type": "string"
    }
  ],
  "source_contract": {
    "entrypoints": [
      "skills/larena/SKILL.md",
      "skills/larena/references/canonical-package-portfolio.md"
    ],
    "processes": [
      "skills/larena/activities/activity-registry.json"
    ],
    "checks": [
      "mirai/graph/specs/index.json"
    ]
  },
  "file_manifest": [
    {
      "path": "src/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "config/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "database/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "resources/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "routes/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "tests/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "composer.json",
      "ownership": "owner_template",
      "required": true,
      "materializer": "template_file",
      "source": "composer.json"
    },
    {
      "path": "source/",
      "ownership": "local_only",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "docs/larena-package-contract.md",
      "ownership": "owner_template",
      "required": true,
      "materializer": "template_file",
      "source": "docs/owner-contract.md"
    }
  ],
  "availability": {
    "policy": "local_skill_override",
    "default_state": "available"
  },
  "migrations": [
    {
      "id": "larena.package.v1-to-v2-project-technology-capability",
      "from": "1.0.0",
      "to": "2.0.0",
      "operation": "declare_project_technology_capability",
      "preserve_user_owned": true
    }
  ],
  "materialization": {
    "mode": "declarative_manifest",
    "generator_contract": "repository_factory.manifest.v1",
    "template_root": "templates",
    "template_files": [
      "composer.json",
      "docs/owner-contract.md"
    ]
  },
  "validators": [
    {
      "id": "larena.source-check.1",
      "type": "owner_source",
      "ref": "mirai/graph/specs/index.json",
      "required": true
    }
  ]
}
